{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secret Tunnel",
  "version": "0.1.0",
  "identifier": "com.georgefejer.chatgpt-local-mcp-launcher",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Secret Tunnel",
        "width": 580,
        "height": 560,
        "minWidth": 580,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/",
      "resources/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
